# Copy this file to .env.local, fill only the providers you use, then restart npm run dev.
# API keys remain server-side and are never returned to or stored by the browser.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_ENDPOINT=https://api.openai.com/v1/chat/completions

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/chat/completions

MINIMAX_API_KEY=
# Model names are unrestricted. For example, replace this with MiniMax-M3 when your account/region supports it.
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_ENDPOINT=https://api.minimax.io/anthropic/v1/messages

KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_API_ENDPOINT=https://api.moonshot.cn/v1/chat/completions

GLM_API_KEY=
GLM_MODEL=glm-5.2
GLM_API_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Optional: add any number of OpenAI-compatible models. apiKeyEnv names another
# variable in this same file. adapter may be openai/deepseek/minimax/kimi/glm/generic.
# POCKET_CUSTOM_MODELS_JSON=[{"id":"my-model","name":"My Model","endpoint":"https://api.example.com/v1/chat/completions","model":"model-id","apiKeyEnv":"MY_MODEL_API_KEY","adapter":"generic"}]
# MY_MODEL_API_KEY=
